#. Plugin Name of the plugin
#: fancy-product-page.php
msgid "Fancy Product Page"
msgstr "Fancy Product Page"

#. Description of the plugin
#: fancy-product-page.php
msgid "Display a WooCommerce product using an ordinary WordPress Page or Post in place of the default single-product template."
msgstr "Zeige ein WooCommerce-Produkt mithilfe einer gewöhnlichen WordPress-Seite oder eines Beitrags anstelle der standardmäßigen Einzelproduktvorlage an."

#: includes/shortcode-add-to-cart-button.php:77
msgid "Failed to determine the product"
msgstr "Das Produkt konnte nicht ermittelt werden"

#. Author of the plugin
#: fancy-product-page.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#: views/product-meta-box.php:22
msgctxt "dropdown option; use no fancy page"
msgid "Standard WooCommerce product page"
msgstr "Standard-WooCommerce-Produktseite"

#: views/product-meta-box.php:38
msgctxt "placeholder for a page/post with an empty title"
msgid "No title"
msgstr "Kein Titel"

#: views/product-meta-box.php:51
msgctxt "meta box field label; the page that replaces this product page"
msgid "Fancy product page"
msgstr "Ausgefallene Produktseite"

#: views/product-meta-box.php:54
msgid "Choose the page or post to use for this product in the frontend."
msgstr "Wählen Sie die Seite oder den Beitrag aus, die bzw. der im Frontend für dieses Produkt verwendet werden soll."

#: views/product-meta-box.php:64
msgid "Write the structured data to the fancy product page?"
msgstr "Die strukturierten Daten auf die ansprechende Produktseite schreiben?"

#: views/product-meta-box.php:66
msgid "Leave this checked unless something else on the page (an SEO plugin, or hand-written markup) already outputs product schema.org data."
msgstr "Lassen Sie dieses Kontrollkästchen aktiviert, es sei denn, etwas anderes auf der Seite (ein SEO-Plugin oder manuell erstellter Markup-Code) gibt bereits Schema.org-Daten für Produkte aus."

#: includes/shortcode-add-to-cart-button.php:83
msgctxt "verb; button label on a shop button"
msgid "Add to cart"
msgstr "In den Warenkorb"

