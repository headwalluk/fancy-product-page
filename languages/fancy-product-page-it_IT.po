#. Plugin Name of the plugin
#: fancy-product-page.php
msgid "Fancy Product Page"
msgstr "Pagina del prodotto di lusso"

#. Plugin URI of the plugin
#: fancy-product-page.php
msgid "https://github.com/headwalluk/fancy-product-page"
msgstr "https://github.com/headwalluk/fancy-product-page"

#. Description of the plugin
#: fancy-product-page.php
msgid "Display a WooCommerce product using an ordinary WordPress Page or Post in place of the default single-product template."
msgstr "Visualizza un prodotto WooCommerce utilizzando una normale pagina o un normale articolo di WordPress al posto del modello predefinito per la pagina del singolo prodotto."

#: includes/shortcode-add-to-cart-button.php:75
msgid "Failed to determine the product"
msgstr "Impossibile identificare il prodotto"

#. Author of the plugin
#: fancy-product-page.php
msgid "Paul Faulkner"
msgstr "Paul Faulkner"

#. Author URI of the plugin
