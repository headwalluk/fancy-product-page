msgid "https://headwall-hosting.com"
msgstr "https://headwall-hosting.com"

#: admin-templates/product-meta-box.php:21
msgctxt "dropdown option; use no fancy page"
msgid "Standard WooCommerce product page"
msgstr "Pagina prodotto standard di WooCommerce"

#: admin-templates/product-meta-box.php:36
msgctxt "placeholder for a page/post with an empty title"
msgid "No title"
msgstr "Senza titolo"

#: admin-templates/product-meta-box.php:49
msgctxt "meta box field label; the page that replaces this product page"
msgid "Fancy product page"
msgstr "Pagina del prodotto personalizzata"

#: admin-templates/product-meta-box.php:52
msgid "Choose the page or post to use for this product in the frontend."
msgstr "Scegli la pagina o il post da utilizzare per questo prodotto nell'interfaccia pubblica."

#: admin-templates/product-meta-box.php:67
msgid "Write the structured data to the fancy product page?"
msgstr "Inserire i dati strutturati nella pagina dedicata al prodotto di punta?"

#: admin-templates/product-meta-box.php:69
msgid "Leave this checked unless something else on the page (an SEO plugin, or hand-written markup) already outputs product schema.org data."
msgstr "Lascia questa opzione selezionata, a meno che un altro elemento della pagina (un plugin SEO o un codice scritto manualmente) non generi già i dati schema.org relativi al prodotto."

#: includes/class-settings.php:41
msgctxt "permission error shown in place of the settings page"
msgid "Not authorized"
msgstr "Non autorizzato"

#: includes/class-settings.php:63
msgctxt "verb; form submit button label"
msgid "Save Changes"
msgstr "Salva modifiche"

#: includes/shortcode-add-to-cart-button.php:81
msgctxt "verb; button label on a shop button"
msgid "Add to cart"
msgstr "Aggiungi al carrello"