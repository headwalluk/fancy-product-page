#. Plugin Name of the plugin
#: fancy-product-page.php
msgid "Fancy Product Page"
msgstr "Σελίδα προϊόντος με ιδιαίτερο στυλ"

#. Plugin URI of the plugin
#: fancy-product-page.php
msgid "https://github.com/headwalluk/fancy-product-page"
msgstr "https://github.com/headwalluk/fancy-product-page"

#. Description of the plugin
#: fancy-product-page.php
msgid "Display a WooCommerce product using an ordinary WordPress Page or Post in place of the default single-product template."
msgstr "Εμφάνιση ενός προϊόντος WooCommerce χρησιμοποιώντας μια απλή σελίδα ή ανάρτηση του WordPress αντί του προεπιλεγμένου προτύπου για μεμονωμένα προϊόντα."

#: includes/shortcode-add-to-cart-button.php:75
msgid "Failed to determine the product"
msgstr "Δεν ήταν δυνατό να προσδιοριστεί το προϊόν"

#. Author of the plugin
#: fancy-product-page.php
msgid "Paul Faulkner"
msgstr "Πολ Φόλκνερ"

#. Author URI of the plugin
#: fancy-product-page.php
msgid "https://headwall-hosting.com"
msgstr "https://headwall-hosting.com"

#: admin-templates/product-meta-box.php:21
msgctxt "dropdown option; use no fancy page"
msgid "Standard WooCommerce product page"
msgstr "Τυπική σελίδα προϊόντος WooCommerce"

#: admin-templates/product-meta-box.php:36
msgctxt "placeholder for a page/post with an empty title"
msgid "No title"
msgstr "Χωρίς τίτλο"

#: admin-templates/product-meta-box.php:49
msgctxt "meta box field label; the page that replaces this product page"
msgid "Fancy product page"
msgstr "Ειδική σελίδα προϊόντος"

#: admin-templates/product-meta-box.php:52
msgid "Choose the page or post to use for this product in the frontend."
msgstr "Επιλέξτε τη σελίδα ή την ανάρτηση που θα χρησιμοποιηθεί για αυτό το προϊόν στο περιβάλλον χρήστη."

#: admin-templates/product-meta-box.php:67
msgid "Write the structured data to the fancy product page?"
msgstr "Να εισαχθούν τα δομημένα δεδομένα στη σελίδα του προϊόντος με την ελκυστική παρουσίαση;"

#: admin-templates/product-meta-box.php:69
msgid "Leave this checked unless something else on the page (an SEO plugin, or hand-written markup) already outputs product schema.org data."
msgstr "Αφήστε αυτό το πλαίσιο επιλεγμένο, εκτός αν κάποιο άλλο στοιχείο της σελίδας (ένα πρόσθετο SEO ή χειροκίνητη σήμανση) εμφανίζει ήδη δεδομένα schema.org για τα προϊόντα."

#: includes/class-settings.php:41
msgctxt "permission error shown in place of the settings page"
msgid "Not authorized"
msgstr "Δεν έχετε δικαιώματα πρόσβασης"

#: includes/class-settings.php:63
msgctxt "verb; form submit button label"
msgid "Save Changes"
msgstr "Αποθήκευση αλλαγών"

#: includes/shortcode-add-to-cart-button.php:81
msgctxt "verb; button label on a shop button"
msgid "Add to cart"
msgstr "Προσθήκη στο καλάθι"